---
layout: layout.njk
---
<main id="top">
  <article class="container article-reader single-post">
    <div class="full-article">
      <div class="article-kicker">{{ category }} · {{ readTime }} MIN READ</div>
      <time class="post-page-date" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      <h1>{{ title }}</h1>
      {% if description %}<p class="article-lead">{{ description }}</p>{% endif %}

      <div class="article-body">
        {{ content | safe }}
      </div>
    </div>
  </article>
</main>
